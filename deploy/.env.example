# Copy to deploy/.env and fill every value.
# docker compose reads this file automatically.

# --- API ---
API_PORT=8080
PUBLIC_BASE_URL=https://api.your-domain.com
CORS_ALLOWED_ORIGINS=https://admin.your-domain.com

# --- MySQL ---
DB_USER=truereport
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-other-strong-password

# --- Secrets (base64, 32 bytes each) ---
# openssl rand -base64 32
JWT_SECRET=
APP_ENCRYPTION_KEY=

# --- Translation ---
# Keep in sync with the LIVE languages in the product.
LIBRETRANSLATE_LANGUAGES=en,es,fr
