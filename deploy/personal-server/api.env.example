# Environment for the API service (systemd EnvironmentFile or run-api.ps1).
# No quotes around values. One KEY=value per line.

SPRING_PROFILES_ACTIVE=prod

# --- Database ---
DB_URL=jdbc:mysql://127.0.0.1:3306/truereport?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USER=truereport
DB_PASSWORD=change-me

# --- Secrets (base64, 32 bytes) ---
# openssl rand -base64 32
JWT_SECRET=
APP_ENCRYPTION_KEY=

# --- Translation ---
I18N_TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=http://127.0.0.1:5000
LIBRETRANSLATE_TIMEOUT=30s

# --- Product URLs ---
PUBLIC_BASE_URL=https://api.your-domain.com
CORS_ALLOWED_ORIGINS=https://admin.your-domain.com

# --- Storage (Linux example) ---
STORAGE_ROOT=/opt/truereport/.truereport-storage

# Writable copy of server/src/main/resources/i18n. Approved interface text is
# written back here as <namespace>/<lang>.json.
UI_MESSAGES_DIR=/opt/truereport/i18n

# --- Misc ---
DEV_SEED_ENABLED=false
MANAGEMENT_HEALTH_MAIL_ENABLED=false
