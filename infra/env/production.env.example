# Copy to infra/prod.env and fill from a secret manager. Never commit prod.env.
DB_NAME=truereport
DB_USER=truereport
MYSQL_USER=truereport
MYSQL_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_BASE64_32_BYTES
APP_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
APP_PII_KEYS=CHANGE_ME_KEY_ID:CHANGE_ME_BASE64_32_BYTES
APP_PII_ACTIVE_KEY_ID=v1
ADMIN_TOTP_REQUIRED=false
DEV_SEED_ENABLED=false
CORS_ALLOWED_ORIGINS=https://admin.example.invalid
PUBLIC_BASE_URL=https://reports.example.invalid

# Self-hosted filesystem storage (owner decision). Mounted persistent volume.
STORAGE_ROOT=/app/.truereport-storage
STORAGE_PERSISTENT_VOLUME=true
STORAGE_MIN_FREE_BYTES=1073741824
STORAGE_MAX_OBJECT_BYTES=52428800
STORAGE_MAX_TOTAL_BYTES=21474836480
STORAGE_WEB_ROOT=

# The S3 adapter remains in code but is DISABLED and unused. Do not set these.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PATH_STYLE=
# S3_CREATE_BUCKET=
# S3_SSE=
# S3_KMS_KEY_ID=

DELIVERY_EMAIL_PROVIDER=smtp
DELIVERY_FROM_ADDRESS=reports@example.invalid
DELIVERY_WEBHOOK_SECRET=CHANGE_ME
DELIVERY_ALLOWED_PHONE_RECIPIENTS=
DELIVERY_ALLOWED_EMAIL_RECIPIENTS=
DELIVERY_REAL_RECIPIENTS_ENABLED=true
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_AUTH=true
SMTP_STARTTLS=true
RETENTION_ENABLED=true
RETENTION_REVOKED_LINK_DAYS=0
RETENTION_DELIVERY_DAYS=0
RETENTION_SOFT_DELETED_EVIDENCE_DAYS=0
RETENTION_DELETE_SOFT_DELETED_EVIDENCE=false
