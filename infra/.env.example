# Copy to infra/.env and fill local values. NEVER commit .env.
DB_NAME=truereport
DB_USER=truereport
DB_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# Base64-encoded 32-byte secrets. Generate with:
#   PowerShell: [Convert]::ToBase64String([byte[]](1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   OpenSSL:    openssl rand -base64 32
JWT_SECRET=replace-with-base64-32-byte-secret
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Local only. MinIO is archived; do not use in production.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password

# Development seed is disabled by default. Set true and a local password to create
# admin.a@truereport.test, tech.a@truereport.test, admin.b@truereport.test and
# platform@truereport.test. Never use these accounts in production.
DEV_SEED_ENABLED=false
DEV_SEED_PASSWORD=

SPRING_PROFILES_ACTIVE=dev
