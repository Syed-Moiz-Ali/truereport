{
  "name": "truereport-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Browser E2E harness for the TrueReport Flutter web apps and public report",
  "scripts": {
    "e2e:list": "playwright test --list",
    "e2e": "playwright test",
    "e2e:platform": "playwright test --project=platform-admin",
    "e2e:workshop": "playwright test --project=workshop-admin",
    "e2e:technician": "playwright test --project=technician",
    "e2e:public": "playwright test --project=public-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
